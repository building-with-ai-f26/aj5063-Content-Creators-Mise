# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Check https://openrouter.ai/models?max_price=0 for current free models.
# nvidia/nemotron-3.5-super-vl:free was a solid free option as of Nov 2026,
# but OpenRouter's free list rotates often, so confirm before relying on it.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
